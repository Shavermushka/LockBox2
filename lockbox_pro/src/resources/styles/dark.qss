/* Тёмная тема для LockBox Pro */
QMainWindow {
    background-color: #2b2b2b;
    color: #eee;
}

QWidget {
    background-color: #2b2b2b;
    color: #eee;
}

QTableWidget {
    background-color: #3c3c3c;
    color: #eee;
    gridline-color: #555;
    alternate-background-color: #454545;
}

QHeaderView::section {
    background-color: #2b2b2b;
    color: #eee;
    padding: 4px;
    border: 1px solid #555;
}

QLineEdit, QTextEdit, QComboBox, QSpinBox {
    background-color: #3c3c3c;
    color: #eee;
    border: 1px solid #555;
    border-radius: 3px;
    padding: 4px;
}

QPushButton {
    background-color: #3c3c3c;
    color: #eee;
    border: 1px solid #555;
    border-radius: 3px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #4a4a4a;
}

QPushButton:pressed {
    background-color: #5a5a5a;
}

QMenuBar {
    background-color: #2b2b2b;
    color: #eee;
}

QMenu {
    background-color: #3c3c3c;
    color: #eee;
}

QMenu::item:selected {
    background-color: #4a4a4a;
}

QStatusBar {
    background-color: #2b2b2b;
    color: #aaa;
}

QDialog {
    background-color: #2b2b2b;
    color: #eee;
}

QGroupBox {
    border: 1px solid #555;
    border-radius: 5px;
    margin-top: 10px;
}

QGroupBox::title {
    color: #eee;
}

QProgressBar {
    background-color: #3c3c3c;
    color: #eee;
    border: 1px solid #555;
    border-radius: 3px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #4d6bfe;
    border-radius: 3px;
}
