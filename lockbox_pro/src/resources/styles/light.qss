/* Светлая тема для LockBox Pro */
QMainWindow {
    background-color: #f5f5f5;
    color: #222;
}

QWidget {
    background-color: #f5f5f5;
    color: #222;
}

QTableWidget {
    background-color: white;
    color: #222;
    gridline-color: #ddd;
    alternate-background-color: #f9f9f9;
}

QHeaderView::section {
    background-color: #f0f0f0;
    color: #222;
    padding: 4px;
    border: 1px solid #ddd;
}

QLineEdit, QTextEdit, QComboBox, QSpinBox {
    background-color: white;
    color: #222;
    border: 1px solid #ddd;
    border-radius: 3px;
    padding: 4px;
}

QPushButton {
    background-color: #e0e0e0;
    color: #222;
    border: 1px solid #ccc;
    border-radius: 3px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #d0d0d0;
}

QPushButton:pressed {
    background-color: #c0c0c0;
}

QMenuBar {
    background-color: #f5f5f5;
    color: #222;
}

QMenu {
    background-color: white;
    color: #222;
}

QMenu::item:selected {
    background-color: #d0d0d0;
}

QStatusBar {
    background-color: #f5f5f5;
    color: #555;
}

QDialog {
    background-color: #f5f5f5;
    color: #222;
}

QGroupBox {
    border: 1px solid #ddd;
    border-radius: 5px;
    margin-top: 10px;
}

QGroupBox::title {
    color: #222;
}

QProgressBar {
    background-color: white;
    color: #222;
    border: 1px solid #ddd;
    border-radius: 3px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #4d6bfe;
    border-radius: 3px;
}
